# PostgreSQL's initial administrator username.
POSTGRES_USER=docdesk_admin

# Replace this value in your local .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The database created when PostgreSQL first initializes.
POSTGRES_DB=docdesk

# Optional for search; required for generated answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini